# Used by the FastAPI backend (backend/app/db.py)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scopelabs"

# Used by the Next.js frontend to reach the backend.
# Locally an absolute URL; on Vercel set this to "/api".
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Optional, server-side only. Either key enables the AI upload assistant.
# Gemini is tried first when set; Anthropic is used when Gemini is missing,
# its key is rejected, or a call fails.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
